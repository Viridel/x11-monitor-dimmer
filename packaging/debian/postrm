#!/bin/sh
set -e

if command -v update-desktop-database >/dev/null 2>&1; then
    update-desktop-database /usr/share/applications >/dev/null 2>&1 || true
fi
if command -v gtk-update-icon-cache >/dev/null 2>&1; then
    gtk-update-icon-cache -q -t -f /usr/share/icons/hicolor >/dev/null 2>&1 || true
fi

if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
    if command -v loginctl >/dev/null 2>&1; then
        for sid in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
            active=$(loginctl show-session "$sid" -p Active --value 2>/dev/null || true)
            user=$(loginctl show-session "$sid" -p Name --value 2>/dev/null || true)
            if [ "$active" = "yes" ] && [ -n "$user" ] && [ "$user" != "root" ]; then
                passwd_line=$(getent passwd "$user" 2>/dev/null || true)
                [ -n "$passwd_line" ] || continue
                home=$(printf '%s' "$passwd_line" | cut -d: -f6)
                desktop_dir="$home/Desktop"
                cfg="$home/.config/user-dirs.dirs"
                if [ -r "$cfg" ]; then
                    raw=$(sed -n 's/^XDG_DESKTOP_DIR="\([^"]*\)".*/\1/p' "$cfg" | head -n1)
                    case "$raw" in
                        '$HOME'/*) desktop_dir="$home/${raw#\$HOME/}" ;;
                        /*) desktop_dir="$raw" ;;
                    esac
                fi
                rm -f "$desktop_dir/X11 Monitor Dimmer.desktop" >/dev/null 2>&1 || true
            fi
        done
    fi
fi

exit 0
